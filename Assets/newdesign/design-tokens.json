{
  "name": "HOL Cartoon Theme",
  "version": "2.0.0",
  "referenceViewport": {
    "width": 1080,
    "height": 1920,
    "orientation": "portrait"
  },
  "colors": {
    "outline": "#140A22",
    "background0": "#12071F",
    "background1": "#241645",
    "surface": "#241645",
    "surfaceElevated": "#3A2068",
    "cyan": "#40D9FF",
    "blue": "#2A8DFF",
    "magenta": "#E84791",
    "violet": "#8B6CFF",
    "gold": "#FFCA55",
    "success": "#8AD64F",
    "textPrimary": "#F5F0FF",
    "textSecondary": "#D7CCED",
    "textMuted": "#9E90BA"
  },
  "roles": {
    "primaryAction": "gold",
    "secondaryAction": "cyan",
    "navigation": "blue",
    "opponentCompetitive": "magenta",
    "supportingAccent": "violet",
    "success": "success"
  },
  "gradient": {
    "accentStart": "#40D9FF",
    "accentEnd": "#E84791",
    "angle": 35,
    "usage": "atmospheric_additive_only"
  },
  "layout": {
    "screenPadding": 48,
    "cardRadius": 28,
    "buttonRadius": 26,
    "controlHeight": 132,
    "sectionGap": 28,
    "touchTargetMin": 64
  },
  "typography": {
    "displayResource": "phase2a/fonts/HOL Menu Display SDF",
    "bodyResource": "phase2a/fonts/HOL Menu Body SDF",
    "headingWeight": "bold_arcade",
    "bodyWeight": "clean_readable",
    "localized": true,
    "languages": ["en", "el"]
  },
  "motifs": {
    "preferred": ["numbers", "chevrons", "lightning", "stars", "sparks", "confetti", "trophy", "mascots"],
    "avoidAsFiller": ["hearts"],
    "rideCoreMotifsForbidden": true
  },
  "rendering": {
    "approvedAssetIsSourceOfTruth": true,
    "normalAssetAlpha": 1.0,
    "nineSliceSuffix": "_9s",
    "nineSliceImageType": "Sliced",
    "proceduralReplacementAllowed": false,
    "additiveGlowAllowed": true
  },
  "monetization": {
    "interstitial": "post_match_only",
    "rewarded": ["save_streak", "free_rematch"],
    "active_duel_ads": false,
    "reward_disclosure_required": true,
    "cosmetics_pay_to_win": false
  }
}
